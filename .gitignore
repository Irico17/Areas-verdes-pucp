# Dependencies
node_modules/
.pnpm-store/
.npm/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
service-account*.json

# Build / cache
dist/
build/
.turbo/
.cache/
*.tsbuildinfo
.vite/
coverage/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs / temp
*.log
tmp/
temp/
.tmp/

# Local DB dumps (keep schema migrations in repo)
*.sql.gz
*.dump
data/v1/*.pgdump
data/evidencias/

# Python
__pycache__/
.venv/
venv/
*.pyc

# Large accidental downloads
*.zip
*.tar
*.tar.gz
!data/raw/**/*.geojson

# Material de arranque local, no forma parte del repo
/uploads/

# Worker de MapLibre copiado en el build (no es fuente)
apps/web/public/maplibre-gl-worker.mjs
apps/web/public/maplibre-gl-shared.mjs

# Binarios Go
apps/api/bin/
*.exe
*.test

# Ambientes locales (los *.env.example sí se versionan)
deploy/env/*.env
!deploy/env/*.env.example
deploy/state/

# Terraform local (el lock sí se versiona)
infra/terraform/.terraform/
infra/terraform/nonprod/.terraform/
infra/terraform/nonprod/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log

# backend (init/backend)
backend/app/bin/

# Capturas de la ola de claridad (se archivan fuera del commit si pesan)
apps/web/e2e-artifacts/

# Fotos recuperadas de Drive: caché local, nunca al repo
data/raw/drive_fotos/*.jpg
data/raw/drive_fotos/*.jpeg

# Credenciales locales del administrador (nunca versionar)
CREDENCIALES-LOCAL.md
