# Copia local: deploy/env/produccion.env (no se versiona).
# Sirve para levantar producción EN ESTA MÁQUINA, junto a develop y qa.
# No es la clave de la EC2. En GitHub/EC2 use TF_VAR_db_password y TF_VAR_dev_password
# (16 caracteres o más, distintas de pando-local y de los otros ambientes).

APP_ENV=produccion
POSTGRES_USER=campus
POSTGRES_PASSWORD=produccion-local-demo-2026
POSTGRES_DB=campus_verde_produccion
POSTGRES_PORT=5434
API_PORT=8291
WEB_PORT=8288

# Solo la simulación local. No la reutilice en la EC2.
CAMPUS_DEV_PASSWORD=produccion-local-demo-2026
CAMPUS_COOKIE_SECURE=false
CAMPUS_ENV=production
CAMPUS_CORS_ORIGINS=http://127.0.0.1:8288,http://localhost:8288

# Región del SDK. No es un secreto.
AWS_REGION=us-east-1
# Cubo S3 privado de producción. Vacío = disco (solo la simulación local).
# El nombre real va en deploy/env/produccion.env (no versionado) o en el host.
# Credenciales, fuera del repo y distintas de qa y de develop: rol de la
# instancia (s3:PutObject y s3:GetObject sobre ese cubo) o, si no hay rol,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY y AWS_SESSION_TOKEN en el
# environment de GitHub «produccion» o en host.env. No las pegue aquí.
EVIDENCIAS_BUCKET=
