# Copia local: deploy/env/qa.env (no se versiona).
# Valores de demostración. No son secretos de la EC2 ni del Learner Lab.

APP_ENV=qa
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus-qa
POSTGRES_DB=campus_verde_qa
POSTGRES_PORT=5433
API_PORT=8191
WEB_PORT=8188

CAMPUS_DEV_PASSWORD=pando-local
CAMPUS_COOKIE_SECURE=false
CAMPUS_ENV=qa
CAMPUS_CORS_ORIGINS=http://127.0.0.1:8188,http://localhost:8188

# Región del SDK. No es un secreto.
AWS_REGION=us-east-1
# Cubo S3 privado de qa. Vacío = disco.
# El nombre real va en deploy/env/qa.env (no versionado) o en el host.
# Credenciales, fuera del repo y propias de este ambiente: rol de la instancia
# (s3:PutObject y s3:GetObject sobre ese cubo) o, si no hay rol,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY y AWS_SESSION_TOKEN en el
# environment de GitHub «qa» o en host.env. No las pegue aquí.
EVIDENCIAS_BUCKET=
