# Archivo de configuración en el host: /opt/campus/develop/host.env (modo 600)
# Creado por el operador en la EC2 compartida para el runner self-hosted (campus-develop).
# Valores de muestra no secretos para desarrollo.

APP_ENV=develop
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus-develop
POSTGRES_DB=campus_verde_develop
POSTGRES_PORT=5432
API_PORT=8091
WEB_PORT=8088

# Cuentas locales / ficticias (norte, sur, riego, coordinacion, jefatura, admin)
CAMPUS_DEV_PASSWORD=pando-local
CAMPUS_CORS_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
CAMPUS_COOKIE_SECURE=false
CAMPUS_ENV=develop
CAMPUS_DATA_DIR=/opt/campus/develop/data
PUBLIC_URL=http://127.0.0.1:8088
