# Archivo de configuración en el host: /opt/campus/host.env (modo 600)
# Creado por el operador en la EC2 de producción para el runner self-hosted (campus-prod).
# En producción real las contraseñas deben tener >= 16 caracteres y NO ser de laboratorio
# (se rechazan pando-local y campus-lab).

APP_ENV=produccion
POSTGRES_USER=campus
POSTGRES_PASSWORD=produccion-host-ejemplo-2026
POSTGRES_DB=campus_verde
POSTGRES_PORT=5432
API_PORT=8091
WEB_PORT=80

# Contraseña de cuentas locales en producción (>= 16 caracteres, no de laboratorio)
CAMPUS_DEV_PASSWORD=produccion-host-ejemplo-2026
CAMPUS_CORS_ORIGINS=http://127.0.0.1,http://localhost
CAMPUS_COOKIE_SECURE=false
CAMPUS_ENV=production
CAMPUS_DATA_DIR=/opt/campus/data
PUBLIC_URL=http://127.0.0.1

# Stack legado para la primera migración en producción (opcional)
LEGACY_PROJECT=campus
LEGACY_COMPOSE=/opt/campus/docker-compose.yml
