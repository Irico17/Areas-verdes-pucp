# Archivo de configuración en el host: /opt/campus/qa/host.env (modo 600)
# Creado por el operador en la EC2 compartida para el runner self-hosted (campus-qa).
# Valores de muestra no secretos para control de calidad.

APP_ENV=qa
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus-qa
POSTGRES_DB=campus_verde_qa
POSTGRES_PORT=5433
API_PORT=8191
WEB_PORT=8188

# Cuentas locales / ficticias
CAMPUS_DEV_PASSWORD=pando-local
CAMPUS_CORS_ORIGINS=http://127.0.0.1:8188,http://localhost:8188
CAMPUS_COOKIE_SECURE=false
CAMPUS_ENV=qa
CAMPUS_DATA_DIR=/opt/campus/qa/data
PUBLIC_URL=http://127.0.0.1:8188
