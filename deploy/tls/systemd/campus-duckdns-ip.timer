# Cada 5 minutos, solo en el host de producción, y solo cuando ya se decidió
# que el dominio apunte a esa máquina. No lo habilite antes.
# systemctl enable --now campus-duckdns-ip.timer

[Unit]
Description=Actualiza cada 5 minutos la IP DuckDNS de verde-pucp

[Timer]
OnCalendar=*:0/5
Persistent=true
Unit=campus-duckdns-ip.service

[Install]
WantedBy=timers.target
