# Copia a .env (no se versiona). Valores de desarrollo local.

POSTGRES_USER=campus
POSTGRES_PASSWORD=campus
POSTGRES_DB=campus_verde
POSTGRES_PORT=5432

# Host: puerto publicado por docker compose. Dentro de la red compose el host es "db".
DATABASE_URL=postgres://campus:campus@127.0.0.1:5432/campus_verde?sslmode=disable

# Puerto poco habitual para no chocar con otros servicios.
API_ADDR=:8091

# Extracto OSM commiteado y agenda ficticia. Rutas relativas al raíz del repo si se arranca desde otro cwd;
# el proceso las resuelve solo cuando corre desde el repo.
# EDIFICIOS_PATH=data/osm/edificios_pando.geojson
# RESERVAS_MOCK_PATH=data/mocks/reservas_agenda.mock.json

# Clave compartida de las cuentas locales (norte, sur, riego, coordinacion, jefatura, admin).
# No es un secreto institucional. El SSO de la PUCP no está conectado.
CAMPUS_DEV_PASSWORD=pando-local

# Orígenes CORS, separados por coma. Nunca un asterisco. Vacío: la API no refleja Origin.
# CAMPUS_CORS_ORIGINS=http://127.0.0.1:5173
# CAMPUS_COOKIE_SAMESITE=Lax
# CAMPUS_COOKIE_SECURE=1
# CAMPUS_ENV=production
# CAMPUS_LOGIN_MAX=8

# Archivos de evidencia del piloto. Sin cubo, quedan en disco y no se versionan.
# EVIDENCIAS_DIR=data/evidencias
# EVIDENCIAS_BUCKET=campus-verde-evidencias
