# Copia a .env (no se versiona). Valores de demostración local.
# No pegar claves del laboratorio, de GHCR, de DuckDNS ni de una cuenta real.

# --- Postgres del compose de la raíz ---
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus
POSTGRES_DB=campus_verde
POSTGRES_PORT=5432

# Host publicado por docker compose. Dentro de la red el host es "db".
DATABASE_URL=postgres://campus:campus@127.0.0.1:5432/campus_verde?sslmode=disable

# Alternativa a DATABASE_URL. El código las usa solo si la URL está vacía.
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_USER=campus
# DATABASE_PASSWORD=campus
# DATABASE_NAME=campus_verde
# DATABASE_SCHEMA=public
# DATABASE_SSL_MODE=disable

# Tope del pool. Vacío: 5/2/15m en develop, 8/3/20m en qa, 10/4/30m en el resto.
# DATABASE_MAX_OPEN_CONNS=10
# DATABASE_MAX_IDLE_CONNS=4
# DATABASE_CONN_MAX_LIFETIME=30m

# --- API ---
# Puerto poco habitual para no chocar con otros servicios.
API_ADDR=:8091
# SERVER_PORT=8080
# SERVER_GIN_MODE=debug
# SERVER_TRUSTED_PROXIES=
# LOG_LEVEL=debug
# LOG_FORMAT=console

# develop | qa | produccion. Vacío: comportamiento histórico.
# APP_ENV=develop
# El compose de deploy escribe CAMPUS_ENV. La cookie Secure no depende de ella.
# CAMPUS_ENV=develop

# Clave compartida de las cuentas locales (norte, sur, riego, coordinacion, jefatura, admin).
# Demostración local. No es una clave de la universidad ni sirve en producción.
CAMPUS_DEV_PASSWORD=pando-local
# CAMPUS_LOGIN_MAX=8
# CAMPUS_COOKIE_SAMESITE=Lax
# Cookie Secure solo con HTTPS. En local y en el laboratorio por HTTP tiene que quedar en false.
# CAMPUS_COOKIE_SECURE=false

# Orígenes CORS, separados por coma. Un asterisco se descarta.
# CAMPUS_CORS_ORIGINS=http://127.0.0.1:4317,http://localhost:4317

# SWAGGER_ENABLED=true
# SWAGGER_HOST=127.0.0.1:8091

# --- Rutas de datos (relativas a la raíz si el proceso arranca en otro directorio) ---
# MIGRATIONS_DIR=db/migrations
# SEED_FILE=deploy/seed/ficticio.sql
# SEED_PROFILE=etl
# DATA_RAW_DIR=data/raw
# DATA_V1_DIR=data/v1
# EDIFICIOS_PATH=data/osm/edificios_pando.geojson
# RESERVAS_MOCK_PATH=data/mocks/reservas_agenda.mock.json
# DRIVE_FOTOS_DIR=data/raw/drive_fotos
# OPENAPI_PATH=apps/api/openapi.yaml
# EVIDENCIAS_DIR=data/evidencias

# Cubo privado de evidencias. Vacío: disco. El nombre real no va en este archivo.
EVIDENCIAS_BUCKET=
# Región del SDK. No es un secreto. Las claves, si no hay rol de instancia,
# se inyectan fuera del repositorio (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN).
AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1

# --- Compose por ambiente (deploy/env/*.env, tampoco se versionan) ---
# API_PORT=8091
# WEB_PORT=8088
# WEB_TLS_PORT=443
# PUBLIC_URL=http://127.0.0.1:8088
# CAMPUS_CERTS_DIR=/opt/campus/certs
# CAMPUS_DATA_DIR=/opt/campus/data
# LEGACY_PROJECT=campus
# LEGACY_COMPOSE=/opt/campus/docker-compose.yml

# --- Visor y pruebas (no las lee el binario de la API) ---
# VITE_DEV_API=http://127.0.0.1:8091
# E2E_BASE_URL=http://127.0.0.1:4317
# MIGRATE_TEST_URL=postgres://campus:campus@127.0.0.1:5432/campus?sslmode=disable
# MODELGEN_OUT=

# --- Smoke local (deploy/smoke.sh) ---
# SMOKE_BASE_URL=http://127.0.0.1:8088
# SMOKE_USER=coordinacion
# SMOKE_INSECURE_TLS=0
# SMOKE_TLS_RESOLVE=
# SMOKE_CACERT=
