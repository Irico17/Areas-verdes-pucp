# Copia a .env (no se versiona). Valores de desarrollo local.

POSTGRES_USER=campus
POSTGRES_PASSWORD=campus
POSTGRES_DB=campus_verde
POSTGRES_PORT=5432

# Host: puerto publicado por docker compose. Dentro de la red compose el host es "db".
DATABASE_URL=postgres://campus:campus@127.0.0.1:5432/campus_verde?sslmode=disable
# En el repo el SQL vive en db/migrations. Dentro de la imagen es /opt/campus/migrations.
# MIGRATIONS_DIR=db/migrations
# Configuración granular alternativa (init/backend):
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_USER=campus
# DATABASE_PASSWORD=campus
# DATABASE_NAME=campus_verde
# DATABASE_SCHEMA=public
# DATABASE_SSL_MODE=false

# Puerto poco habitual para no chocar con otros servicios.
API_ADDR=:8091
# SERVER_PORT=8080
# SERVER_GIN_MODE=release

# Extracto OSM commiteado y agenda ficticia. Rutas relativas al raíz del repo si se arranca desde otro cwd;
# el proceso las resuelve solo cuando corre desde el repo.
# EDIFICIOS_PATH=data/osm/edificios_pando.geojson
# RESERVAS_MOCK_PATH=data/mocks/reservas_agenda.mock.json

# Clave compartida de las cuentas locales (norte, sur, riego, coordinacion, jefatura, admin).
# No es un secreto institucional. El SSO de la PUCP no está conectado.
# Solo desarrollo local. La imagen de la API no la trae: el entrypoint falla si falta.
CAMPUS_DEV_PASSWORD=pando-local

# Orígenes CORS, separados por coma. Nunca un asterisco. Vacío: la API no refleja Origin.
# CAMPUS_CORS_ORIGINS=http://127.0.0.1:5173
# CAMPUS_COOKIE_SAMESITE=Lax
# Cookie Secure solo con HTTPS. En HTTP (la IP del lab) tiene que ser false o el navegador no inicia sesión.
# Si se omite, la API la deja en false aunque CAMPUS_ENV=production.
# El deploy la pone en true solo si hay fullchain.pem y privkey.pem en /opt/campus/certs.
# CAMPUS_COOKIE_SECURE=false
# APP_ENV=develop|qa|produccion
# Vacío conserva el comportamiento histórico (Swagger según Gin, pool 10/4/30 min).
# develop: Swagger, logs debug, pool 5/2/15m. qa: Swagger, pool 8/3/20m.
# produccion: sin Swagger, logs info JSON, pool 10/4/30 min.
# LOG_LEVEL=info
# LOG_FORMAT=json
# DATABASE_MAX_OPEN_CONNS=10
# DATABASE_MAX_IDLE_CONNS=4
# DATABASE_CONN_MAX_LIFETIME=30m
# CAMPUS_ENV=production
# CAMPUS_LOGIN_MAX=8

# Archivos de evidencia. Sin EVIDENCIAS_BUCKET quedan en disco y no se versionan.
# EVIDENCIAS_DIR=data/evidencias
# EVIDENCIAS_BUCKET=
# El nombre del cubo privado no va aquí. Las credenciales tampoco:
# rol de la instancia, o AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN inyectados fuera del repositorio.
