# Contexto de build: raíz del repositorio (hace falta db/migrations y data/).
FROM golang:1.25.3-alpine AS build

WORKDIR /src
COPY backend/app/go.mod backend/app/go.sum ./backend/app/
WORKDIR /src/backend/app
RUN go mod download && go mod verify

WORKDIR /src
COPY backend/app ./backend/app
WORKDIR /src/backend/app
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /out/api ./cmd \
 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /out/migrate ./cmd/migrate \
 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /out/etl ./cmd/etl \
 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /out/etl-lote ./cmd/etl-lote \
 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /out/sectores ./cmd/sectores

FROM alpine:3.22
LABEL org.opencontainers.image.source="https://github.com/Irico17/Areas-verdes-pucp"
RUN apk add --no-cache ca-certificates tzdata \
 && addgroup -g 10001 -S app \
 && adduser -S -D -H -u 10001 -G app app

COPY --from=build /out/api /out/migrate /out/etl /out/etl-lote /out/sectores /usr/local/bin/
# Origen del esquema: db/migrations (mismos nombres que schema_migrations.version).
COPY db/migrations /opt/campus/migrations
COPY backend/openapi.yaml /opt/campus/openapi.yaml
COPY backend/openapi /opt/campus/openapi
COPY data/raw /opt/campus/raw
COPY data/osm /opt/campus/osm
COPY data/mocks /opt/campus/mocks
COPY deploy/seed/ficticio.sql /opt/campus/seed/ficticio.sql
COPY backend/docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh /usr/local/bin/api /usr/local/bin/migrate /usr/local/bin/etl /usr/local/bin/etl-lote /usr/local/bin/sectores \
 && mkdir -p /data/evidencias /data/v1 \
 && chown -R 10001:10001 /data

# CAMPUS_DEV_PASSWORD no va en la imagen. El entrypoint sale si falta.
# Desarrollo local: pando-local, documentado en .env.example y en docker-compose.yml.
ENV SERVER_PORT=8091 \
    API_ADDR=:8091 \
    SERVER_GIN_MODE=release \
    SWAGGER_ENABLED=false \
    MIGRATIONS_DIR=/opt/campus/migrations \
    OPENAPI_PATH=/opt/campus/openapi.yaml \
    DATA_RAW_DIR=/opt/campus/raw \
    DATA_V1_DIR=/data/v1 \
    EDIFICIOS_PATH=/opt/campus/osm/edificios_pando.geojson \
    RESERVAS_MOCK_PATH=/opt/campus/mocks/reservas_agenda.mock.json \
    EVIDENCIAS_DIR=/data/evidencias \
    SEED_FILE=/opt/campus/seed/ficticio.sql

USER 10001:10001
EXPOSE 8091
ENTRYPOINT ["/entrypoint.sh"]
