# Server
SERVER_PORT=8080
# API_ADDR=:8091 # If set, overrides SERVER_PORT for compatibility with apps/api
SERVER_GIN_MODE=release # release/debug (default release)
# SERVER_TRUSTED_PROXIES= # Comma-separated list of trusted proxy IPs/CIDRs (e.g. 172.18.0.0/16 for nginx network at cutover; empty = trust none)

# Database (DATABASE_URL has priority if set)
# DATABASE_URL=postgres://campus:campus@127.0.0.1:5432/campus_verde?sslmode=disable
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=areasverdes
DATABASE_PASSWORD=areasverdes
DATABASE_NAME=areasverdes
DATABASE_SCHEMA=public
DATABASE_SSL_MODE=false # false/true or disable/require

# Security
CAMPUS_CORS_ORIGINS=http://localhost:5173
CAMPUS_COOKIE_SECURE=false # true only with HTTPS / TLS
CAMPUS_COOKIE_SAMESITE=Lax # Lax/Strict/None
CAMPUS_LOGIN_MAX=8
CAMPUS_DEV_PASSWORD=pando-local

# Swagger UI (default true in debug, false in release)
SWAGGER_ENABLED=true
# SWAGGER_HOST=localhost:8080 # Optional: host for Swagger UI / contract (default empty = relative)

# Storage and static data paths
# EVIDENCIAS_DIR=./data/evidencias
# EVIDENCIAS_BUCKET=
# DATA_RAW_DIR=./data/raw
# DATA_V1_DIR=./data/v1
# EDIFICIOS_PATH=./data/osm/edificios_pando.geojson
# RESERVAS_MOCK_PATH=./data/mocks/reservas_agenda.mock.json
# DRIVE_FOTOS_DIR=data/raw/drive_fotos
# MIGRATIONS_DIR=./apps/api/migrations
