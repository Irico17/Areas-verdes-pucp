# Copie a produccion.tfvars (no se versiona) si quiere fijar valores no secretos.
# Las claves NO van aquí: TF_VAR_db_password y TF_VAR_dev_password en el entorno.
# produccion conserva los nombres campus-verde del Learner Lab.
# El estado que ya existe sigue en el workspace default hasta que alguien lo mueva a mano.

ambiente      = "produccion"
aws_region    = "us-east-1"
instance_type = "t3.micro"
create_ecr    = true
enable_ecs    = false
