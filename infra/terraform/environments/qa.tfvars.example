# Copie a qa.tfvars (no se versiona) si quiere fijar valores no secretos.
# Las claves NO van aquí: TF_VAR_db_password y TF_VAR_dev_password en el entorno.
# No ejecute apply desde un agente. Workspace: terraform workspace select qa

ambiente      = "qa"
aws_region    = "us-east-1"
instance_type = "t3.micro"
create_ecr    = true
enable_ecs    = false
